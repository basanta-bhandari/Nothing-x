{
  "app-id": "io.github.basanta_bhandari.NothingX",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "nothingx",
  "finish-args": [
    "--share=network", "--share=ipc", "--socket=wayland", "--socket=fallback-x11",
    "--socket=pulseaudio", "--device=dri", "--allow=bluetooth",
    "--system-talk-name=org.bluez", "--talk-name=org.kde.StatusNotifierWatcher"
  ],
  "build-options": {"append-path": "/usr/lib/sdk/rust-stable/bin"},
  "modules": [{
    "name": "krb5",
    "buildsystem": "autotools",
    "subdir": "src",
    "config-opts": ["--disable-static", "--enable-shared", "--without-ldap", "--without-libedit", "--without-keyutils", "--without-system-verto"],
    "sources": [{"type": "archive", "url": "https://kerberos.org/dist/krb5/1.22/krb5-1.22.2.tar.gz", "sha256": "3243ffbc8ea4d4ac22ddc7dd2a1dc54c57874c40648b60ff97009763554eaf13"}]
  }, {
    "name": "nothingx",
    "buildsystem": "simple",
    "build-commands": [
      "cargo build --offline --locked --release --manifest-path rust-engine/Cargo.toml",
      "mkdir -p /app/lib/nothingx",
      "cp -a nothingx /app/lib/nothingx/",
      "mkdir -p /app/share/licenses/nothingx && cp -a LICENSE NOTICE licenses /app/share/licenses/nothingx/",
      "install -Dm755 rust-engine/target/release/libnothingx_rust.so /app/lib/nothingx/nothingx/bin/libnothingx_rust.so",
      "python3 -m pip install --no-index --find-links=wheels --target=/app/lib/nothingx-deps PySide6-Essentials==6.12.0 PySide6-Addons==6.12.0 dbus-next==0.2.3",
      "install -Dm755 packaging/flatpak/nothingx /app/bin/nothingx",
      "install -Dm644 packaging/flatpak/io.github.basanta_bhandari.NothingX.desktop /app/share/applications/io.github.basanta_bhandari.NothingX.desktop",
      "install -Dm644 packaging/flatpak/io.github.basanta_bhandari.NothingX.metainfo.xml /app/share/metainfo/io.github.basanta_bhandari.NothingX.metainfo.xml",
      "install -Dm644 nothingx/assets/cmf-buds-pro-2/blue_case.png /app/share/icons/hicolor/512x512/apps/io.github.basanta_bhandari.NothingX.png",
      "QT_QPA_PLATFORM=offscreen NOTHINGX_PREFERENCES=/tmp/nothingx-build-check/preferences.json /app/bin/nothingx --demo --screenshot /tmp/nothingx-build-check.png",
      "QT_QPA_PLATFORM=offscreen PYTHONPATH=/app/lib/nothingx:/app/lib/nothingx-deps QT_PLUGIN_PATH=/app/lib/nothingx-deps/PySide6/Qt/plugins NOTHINGX_ENGINE=/app/lib/nothingx/nothingx/bin/libnothingx_rust.so python3 tests/test_ui.py -v"
    ],
    "sources": [{"type": "dir", "path": "../../build/flatpak-source"}]
  }]
}
